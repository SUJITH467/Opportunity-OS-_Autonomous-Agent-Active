# OpportunityOS Environment Configuration
# NOTE: Set variable values before deployment. Do not commit sensitive credentials to git.

# Application Runtime
ENVIRONMENT=
DEMO_MODE=
REQUIRE_HUMAN_APPROVAL=true

# Security & Session Authentication
JWT_SECRET=

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=

# AWS Infrastructure (IAM Role based - leave access keys empty when using IAM role)
AWS_REGION=
AWS_ROLE_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon Bedrock Foundation Models
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=

# Amazon DynamoDB Tables
DYNAMODB_STUDENTS_TABLE=
DYNAMODB_OPPORTUNITIES_TABLE=
DYNAMODB_APPLICATIONS_TABLE=
DYNAMODB_DOCUMENTS_TABLE=
DYNAMODB_ACTIVITY_TABLE=

# Amazon S3 Document Storage
S3_BUCKET_NAME=

# Amazon CloudWatch Monitoring
CLOUDWATCH_LOG_GROUP=

# Frontend Configuration
NEXT_PUBLIC_API_URL=
PORT=
