# OpportunityOS Environment Configuration
DEMO_MODE=True
ENVIRONMENT=development

# Security
JWT_SECRET=super-secret-opportunityos-jwt-key-2026

# AWS Bedrock & Cloud Settings
AWS_REGION=us-east-1
